          </div>
        </div>
      `;
    }).join("");
  };

  window.applyAuditCountsToInventory = function() {
    const countedCodes = Object.keys(auditCountsMap);
    if (countedCodes.length === 0) {
      alert("⚠️ Pehle kam se kam 1 item scan karein ya '+1' dabakar ginein!");
      return;
    }
    const rackSel = document.getElementById("auRackFilterSel")?.value || "ALL";
    const msg = rackSel !== "ALL"
      ? `Kya aap Rack "${rackSel}" ke gine hue items ki Physical Qty ko Computer Stock mein save karna chahte hain?`
      : `Kya aap gine hue ${countedCodes.length} items ki Physical Qty ko Computer Stock mein update karna chahte hain?`;
    if (!confirm(msg)) return;

    let updated = 0;
    countedCodes.forEach(code => {
      const item = getLiveInventory().find(i => i && i.code === code);
      if (item) {
        item.qty = auditCountsMap[code];
        updated++;
      }
    });

    if (typeof playPosBeep === "function") playPosBeep(1100, 0.1);
    if (typeof syncToCloud === "function") syncToCloud();
    if (typeof renderStock === "function") renderStock();
    renderAuditList();
    alert(`✅ ${updated} items ka Computer Stock asli Physical Count se update ho gaya!`);
  };

  window.shareAuditReportWA = function() {
    const rackSel = document.getElementById("auRackFilterSel")?.value || "ALL";
    const scoped = getScopedAuditItems();
    const diffs = [];
    let sysSum = 0, phySum = 0;

    scoped.forEach(i => {
      const sys = Math.max(0, Number(i.qty) || 0);
      const phy = auditCountsMap[i.code] || 0;
      sysSum += sys;
      phySum += phy;
      if (phy !== sys) {
        const d = phy - sys;
        diffs.push(`• *${i.code}* (${i.color} ${i.rack ? '| Rack ' + i.rack : ''}): कंप्यूटर ${sys} ➔ मिला *${phy}* (${d > 0 ? '+' + d + ' Extra' : d + ' गायब'})`);
      }
    });

    const lines = [
      `📋 *दीदी की दुकान (SHAKYA COSMETIC) — स्टॉक मिलान रिपोर्ट*`,
      `🗄️ *रैक:* ${rackSel === "ALL" ? "पूरी दुकान" : "Rack " + rackSel} | 📅 *तारीख:* ${new Date().toLocaleDateString("hi-IN")}`,
