<script>
(function() {
  "use strict";

  // Remove any leftover Install App header button if not needed
  const oldInstallBtn = document.getElementById("shInstallPwaBtn");
  if (oldInstallBtn) oldInstallBtn.remove();

  // =========================================================================
  // 1. HYBRID INDEXEDDB VAULT + 5MB LOCALSTORAGE QUOTA ENGINE
  // =========================================================================
  const IDB_NAME = "ShakyaPOS_Vault_v1";
  const IDB_VERSION = 1;
  const STORE_PHOTOS = "parchi_photos";
  const STORE_MIRROR = "kv_mirror";
  const MAX_LS_SALES_FALLBACK = 2000;

  let idbInstance = null;
  let idbPhotoCount = 0;
  let idbPhotoBytes = 0;

  function openShakyaVaultDB() {
    return new Promise((resolve) => {
      if (idbInstance) return resolve(idbInstance);
      if (!window.indexedDB) return resolve(null);
      try {
        const req = indexedDB.open(IDB_NAME, IDB_VERSION);
        req.onupgradeneeded = function(e) {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(STORE_PHOTOS)) {
            db.createObjectStore(STORE_PHOTOS);
          }
          if (!db.objectStoreNames.contains(STORE_MIRROR)) {
            db.createObjectStore(STORE_MIRROR);
          }
        };
        req.onsuccess = function(e) {
          idbInstance = e.target.result;
          resolve(idbInstance);
        };
        req.onerror = function() {
          resolve(null);
        };
      } catch (err) {
        resolve(null);
      }
    });
  }

  async function idbPut(storeName, key, val) {
    const db = await openShakyaVaultDB();
    if (!db) return false;
    return new Promise((resolve) => {
      try {
        const tx = db.transaction(storeName, "readwrite");
        tx.objectStore(storeName).put(val, key);
        tx.oncomplete = () => resolve(true);
        tx.onerror = () => resolve(false);
      } catch (e) {
        resolve(false);
      }
    });
  }

  async function idbGetAllPhotos() {
    const db = await openShakyaVaultDB();
    if (!db) return {};
    return new Promise((resolve) => {
      try {
        const tx = db.transaction(STORE_PHOTOS, "readonly");
        const store = tx.objectStore(STORE_PHOTOS);
        const out = {};
        const req = store.openCursor();
        let count = 0;
        let bytes = 0;
        req.onsuccess = function(e) {
          const cursor = e.target.result;
          if (cursor) {
            out[cursor.key] = cursor.value;
            count++;
            bytes += String(cursor.value || "").length * 2;
            cursor.continue();
          } else {
            idbPhotoCount = count;
            idbPhotoBytes = bytes;
            resolve(out);
          }
        };
        req.onerror = () => resolve({});
      } catch (e) {
        resolve({});
      }
    });
  }

  async function idbGetMirror(key) {
    const db = await openShakyaVaultDB();
    if (!db) return null;
    return new Promise((resolve) => {
      try {
        const tx = db.transaction(STORE_MIRROR, "readonly");
        const req = tx.objectStore(STORE_MIRROR).get(key);
        req.onsuccess = () => resolve(req.result ?? null);
        req.onerror = () => resolve(null);
      } catch (e) {
        resolve(null);
      }
    });
  }

  // Intercept localStorage.setItem so sc_mandi_bills NEVER writes base64 photos
  // into the 5 MB localStorage quota, and rescues any QuotaExceededError automatically.
  const origSetItem = Storage.prototype.setItem;
  if (!Storage.prototype.setItem._shakyaQuotaWrapped) {
    const wrappedSetItem = function(key, value) {
      if (this !== window.localStorage) {
        return origSetItem.call(this, key, value);
      }

      let valToWrite = String(value);

      // Offload heavy Mandi Parchi base64 photos to IndexedDB before hitting localStorage
      if (key === "sc_mandi_bills") {
        try {
          const parsed = JSON.parse(valToWrite);
          if (Array.isArray(parsed)) {
            const slimBills = parsed.map((b) => {
              if (!b || typeof b !== "object") return b;
              const copy = Object.assign({}, b);
              if (copy.parchiPhoto && String(copy.parchiPhoto).startsWith("data:image")) {
                const billId = copy.id || ("MB_" + (copy.billNo || "0"));
                const photoData = copy.parchiPhoto;
                idbPut(STORE_PHOTOS, billId, photoData).then(() => refreshQuotaDashboardUI());
                // Ensure in-memory window.mandiBills still keeps the live photo
                if (Array.isArray(window.mandiBills)) {
                  const memBill = window.mandiBills.find(x => x && x.id === copy.id);
                  if (memBill && !memBill.parchiPhoto) memBill.parchiPhoto = photoData;
                }
                copy.parchiPhoto = "";
                copy.hasIdbPhoto = true;
              }
              return copy;
            });
            valToWrite = JSON.stringify(slimBills);
          }
        } catch (e) {}
      }

      // Async mirror of core POS collections into IndexedDB (500 MB+ safety net)
      const MIRROR_KEYS = [
        "sc_inventory",
        "sc_sales",
        "sc_udhaar_logs",
        "sc_expenses",
        "sc_contacts",
        "sc_mandi_bills",
        "sc_mandi_payments"
      ];
      if (MIRROR_KEYS.includes(key)) {
        idbPut(STORE_MIRROR, key, valToWrite);
      }

      // Attempt localStorage write with automatic QuotaExceededError rescue
      try {
        origSetItem.call(this, key, valToWrite);
      } catch (err) {
        // Emergency Quota Rescue:
        // 1. Strip any legacy base64 photos still sitting in sc_mandi_bills
        try {
          const rawMandi = localStorage.getItem("sc_mandi_bills");
          if (rawMandi && rawMandi.includes("data:image")) {
            const mArr = JSON.parse(rawMandi);
            if (Array.isArray(mArr)) {
              mArr.forEach(b => {
                if (b && b.parchiPhoto && String(b.parchiPhoto).startsWith("data:image")) {
                  idbPut(STORE_PHOTOS, b.id || "MB", b.parchiPhoto);
                  b.parchiPhoto = "";
                  b.hasIdbPhoto = true;
                }
              });
              origSetItem.call(this, "sc_mandi_bills", JSON.stringify(mArr));
            }
          }
        } catch (e2) {}

        // 2. Retry the write; if sc_sales itself is huge, keep newest 2,000 in localStorage
        //    while full sales remain in IndexedDB + Firebase + memory
        try {
          origSetItem.call(this, key, valToWrite);
        } catch (err2) {
          if (key === "sc_sales") {
            try {
              const sArr = JSON.parse(valToWrite);
              if (Array.isArray(sArr) && sArr.length > MAX_LS_SALES_FALLBACK) {
                const hotSales = sArr.slice(0, MAX_LS_SALES_FALLBACK);
                origSetItem.call(this, key, JSON.stringify(hotSales));
              }
            } catch (e3) {}
          }
        }
      }

      setTimeout(refreshQuotaDashboardUI, 60);
    };
    wrappedSetItem._shakyaQuotaWrapped = true;
    Storage.prototype.setItem = wrappedSetItem;
  }

  // Rehydrate Mandi Parchi photos & any mirrored data from IndexedDB on boot
  async function hydrateFromIndexedDBVault() {
    await openShakyaVaultDB();

    // 1. Migrate any existing base64 photos currently sitting in localStorage sc_mandi_bills
    try {
      const rawMandi = localStorage.getItem("sc_mandi_bills");
      if (rawMandi && rawMandi.includes("data:image")) {
        localStorage.setItem("sc_mandi_bills", rawMandi);
      }
    } catch (e) {}

    // 2. Restore all parchiPhotos from IndexedDB into window.mandiBills in memory
    const photoMap = await idbGetAllPhotos();
    if (Array.isArray(window.mandiBills) && Object.keys(photoMap).length > 0) {
      window.mandiBills.forEach((b) => {
        if (b && b.id && photoMap[b.id] && !b.parchiPhoto) {
          b.parchiPhoto = photoMap[b.id];
        }
      });
    }

    // 3. If IndexedDB mirror has a larger sales history than capped localStorage, restore it
    try {
      const mirroredSalesStr = await idbGetMirror("sc_sales");
      if (mirroredSalesStr && typeof sales !== "undefined" && Array.isArray(sales)) {
        const mirroredSales = JSON.parse(mirroredSalesStr);
        if (Array.isArray(mirroredSales) && mirroredSales.length > sales.length) {
          sales.length = 0;
          mirroredSales.forEach(s => sales.push(s));
          if (typeof renderStats === "function") renderStats();
        }
      }
    } catch (e) {}

    refreshQuotaDashboardUI();
  }

  // Re-attach parchiPhotos whenever Firebase updates window.mandiBills
  async function reattachIdbPhotosToMandiBills() {
    const photoMap = await idbGetAllPhotos();
    if (Array.isArray(window.mandiBills)) {
      let changed = false;
      window.mandiBills.forEach((b) => {
        if (b && b.id) {
          if (b.parchiPhoto && String(b.parchiPhoto).startsWith("data:image")) {
            idbPut(STORE_PHOTOS, b.id, b.parchiPhoto);
          } else if (photoMap[b.id]) {
            b.parchiPhoto = photoMap[b.id];
            changed = true;
          }
        }
      });
      if (changed && typeof renderMandiKhataUI === "function") {
        try { renderMandiKhataUI(); } catch (e) {}
      }
    }
    refreshQuotaDashboardUI();
  }

  // =========================================================================
  // 2. STORAGE QUOTA DASHBOARD, 1-TAP OPTIMIZER & 6-MONTH ARCHIVER
  // =========================================================================
  function getQuotaBreakdown() {
    const bytesOf = (k) => {
      try {
        const v = localStorage.getItem(k) || "";
        return (k.length + v.length) * 2;
      } catch (e) {
        return 0;
      }
    };

    let totalBytes = 0;
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i) || "";
        totalBytes += bytesOf(k);
      }
    } catch (e) {}

    const invKB = (bytesOf("sc_inventory") / 1024).toFixed(1);
    const salesKB = (bytesOf("sc_sales") / 1024).toFixed(1);
    const khataKB = ((bytesOf("sc_udhaar_logs") + bytesOf("sc_contacts")) / 1024).toFixed(1);
    const mandiKB = ((bytesOf("sc_mandi_bills") + bytesOf("sc_mandi_payments")) / 1024).toFixed(1);
    const totalKB = Math.round(totalBytes / 1024);
    const maxKB = 5120; // 5 MB standard Chrome origin quota
    const pct = Math.min(100, Math.max(1, Math.round((totalBytes / (5 * 1024 * 1024)) * 100)));

    return { totalBytes, totalKB, maxKB, pct, invKB, salesKB, khataKB, mandiKB };
  }

  function refreshQuotaDashboardUI() {
    let box = document.getElementById("shQuotaVaultBox");
    if (!box) {
      const backupMsg = document.getElementById("backupMsg");
      if (backupMsg && backupMsg.parentElement) {
        box = document.createElement("div");
        box.id = "shQuotaVaultBox";
        backupMsg.parentElement.insertBefore(box, backupMsg);
      }
    }
    if (!box) return;

    const info = getQuotaBreakdown();
    const barColor =
      info.pct >= 80
        ? "linear-gradient(90deg, #ef4444, #dc2626)"
        : info.pct >= 55
        ? "linear-gradient(90deg, #f59e0b, #d97706)"
        : "linear-gradient(90deg, #10b981, #3b82f6)";

    const idbMB = (idbPhotoBytes / (1024 * 1024)).toFixed(2);

    box.innerHTML =
      `<div class="sh-qv-head">` +
        `<div class="sh-qv-title">🛡️ 5 MB Quota Shield & IndexedDB Vault</div>` +
        `<span class="sh-qv-badge">IDB Vault: ${idbPhotoCount} Photos (${idbMB} MB)</span>` +
      `</div>` +
      `<div style="display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:5px;color:#cbd5e1;">` +
        `<span><b>localStorage Used:</b> ${info.totalKB} KB / ${info.maxKB} KB</span>` +
        `<span style="font-weight:900;color:#34d399;">${100 - info.pct}% Free</span>` +
      `</div>` +
      `<div class="sh-qv-track">` +
        `<div class="sh-qv-fill" style="width:${info.pct}%;background:${barColor};"></div>` +
      `</div>` +
      `<div class="sh-qv-grid">` +
        `<div class="sh-qv-chip"><span>📦 Stock (${typeof inventory !== "undefined" ? inventory.length : 0})</span><b>${info.invKB} KB</b></div>` +
        `<div class="sh-qv-chip"><span>🧾 Bills (${typeof sales !== "undefined" ? sales.length : 0})</span><b>${info.salesKB} KB</b></div>` +
        `<div class="sh-qv-chip"><span>📒 Grahak Khata</span><b>${info.khataKB} KB</b></div>` +
        `<div class="sh-qv-chip"><span>🏢 Mandi Khata</span><b>${info.mandiKB} KB</b></div>` +
      `</div>` +
      `<div class="sh-qv-actions">` +
        `<button type="button" class="sh-qv-btn sh-qv-btn-opt" onclick="optimizeShakyaStorageNow()">🧹 Optimize & Free Quota</button>` +
        `<button type="button" class="sh-qv-btn sh-qv-btn-arc" onclick="archiveOldShakyaSales()">📦 Archive >6M Old Bills</button>` +
      `</div>`;
  }

  window.optimizeShakyaStorageNow = async function() {
    const before = getQuotaBreakdown().totalKB;
    let movedCount = 0;

    if (Array.isArray(window.mandiBills)) {
      for (const b of window.mandiBills) {
        if (b && b.parchiPhoto && String(b.parchiPhoto).startsWith("data:image")) {
          const billId = b.id || ("MB_" + (b.billNo || "0"));
          await idbPut(STORE_PHOTOS, billId, b.parchiPhoto);
          movedCount++;
        }
      }
      localStorage.setItem("sc_mandi_bills", JSON.stringify(window.mandiBills));
    }

    await idbGetAllPhotos();
    const after = getQuotaBreakdown().totalKB;
    const savedKB = Math.max(0, before - after);
    refreshQuotaDashboardUI();

    if (typeof showInlineMsg === "function") {
      showInlineMsg(
        "backupMsg",
        `✅ Storage Optimized! ${idbPhotoCount} Mandi Parchi photos IndexedDB Vault (500MB+) me surakshit hain. (${savedKB} KB freed, Current usage: ${after} KB / 5,120 KB)`,
        "success"
      );
    }
  };

  window.archiveOldShakyaSales = function() {
    if (typeof sales === "undefined" || !Array.isArray(sales) || sales.length === 0) {
      if (typeof showInlineMsg === "function") {
        showInlineMsg("backupMsg", "ℹ️ Abhi koi purana sale bill archive karne ke liye nahi hai.", "success");
      }
      return;
    }

    const cutoffMs = Date.now() - (180 * 24 * 60 * 60 * 1000); // 180 days (~6 months)
    const oldSales = [];
    const recentSales = [];

    sales.forEach((s) => {
      if (!s) return;
      const dt = s.isoDate ? new Date(s.isoDate).getTime() : (s.ts || Date.now());
      if (!isNaN(dt) && dt < cutoffMs) {
        oldSales.push(s);
      } else {
        recentSales.push(s);
      }
    });

    if (oldSales.length === 0) {
      if (typeof showInlineMsg === "function") {
        showInlineMsg("backupMsg", "✅ Sabhi bills pichle 6 mahine ke andar ke hain (0 old bills to archive).", "success");
      }
      return;
    }

    // 1. Download archive JSON file first
    const archivePayload = {
      app: "ShakyaCosmeticPOS_SalesArchive",
      archivedAt: new Date().toISOString(),
      cutoffDays: 180,
      archivedSalesCount: oldSales.length,
      sales: oldSales
    };
    const blob = new Blob([JSON.stringify(archivePayload, null, 2)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "Shakya_POS_OldSales_Archive_" + window.getLocalIsoDate() + ".json";
    a.click();

    if (confirm(`📦 ${oldSales.length} purane bills (> 6 months) ki JSON file download ho gayi hai.\n\nKya aap in purane bills ko phone memory se hata kar storage khali karna chahte hain?`)) {
      sales.length = 0;
      recentSales.forEach(s => sales.push(s));
      if (typeof syncToCloud === "function") syncToCloud();
      if (typeof renderStats === "function") renderStats();
      refreshQuotaDashboardUI();
      if (typeof showInlineMsg === "function") {
        showInlineMsg("backupMsg", `✅ ${oldSales.length} purane bills archive ho gaye aur phone memory free ho gayi!`, "success");
      }
    }
  };

  // =========================================================================
  // 3. ALL 8 MASTER BUGFIXES (IST Date, AudioContext, Stock Reset, Audit, etc.)
  // =========================================================================
  window.getLocalIsoDate = function(d) {
    const dt = d instanceof Date ? d : new Date();
    const y = dt.getFullYear();
    const m = String(dt.getMonth() + 1).padStart(2, "0");
    const day = String(dt.getDate()).padStart(2, "0");
    return y + "-" + m + "-" + day;
  };

  function fixDateInputsToLocal() {
    const todayIso = window.getLocalIsoDate();
    const dInp = document.getElementById("statsDateInput");
    const mInp = document.getElementById("statsMonthInput");
    if (dInp && (!dInp.value || dInp.value === new Date().toISOString().slice(0, 10))) {
      dInp.value = todayIso;
    }
    if (mInp && (!mInp.value || mInp.value === new Date().toISOString().slice(0, 7))) {
      mInp.value = todayIso.slice(0, 7);
    }
  }

  let sharedAudioCtx = null;
  window.playPosBeep = function(freq = 880, duration = 0.07) {
    if (typeof soundBeepEnabled !== "undefined" && !soundBeepEnabled) return;
    try {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtx) return;
      if (!sharedAudioCtx || sharedAudioCtx.state === "closed") {
        sharedAudioCtx = new AudioCtx();
      }
      if (sharedAudioCtx.state === "suspended") {
        sharedAudioCtx.resume().catch(() => {});
      }
      const osc = sharedAudioCtx.createOscillator();
      const gain = sharedAudioCtx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(freq, sharedAudioCtx.currentTime);
      gain.gain.setValueAtTime(0.08, sharedAudioCtx.currentTime);
      osc.connect(gain);
      gain.connect(sharedAudioCtx.destination);
      osc.start();
      osc.stop(sharedAudioCtx.currentTime + duration);
    } catch (e) {}
  };

  window.resetStockFilters = function() {
    const fSearch = document.getElementById("fSearch");
    const fCat = document.getElementById("fCat");
    const fStatus = document.getElementById("fStatus");
    const fMahajan = document.getElementById("fMahajan");
    const fRack = document.getElementById("fRack");
    if (fSearch) fSearch.value = "";
    if (fCat) fCat.value = "ALL";
    if (fStatus) fStatus.value = "ALL";
    if (fMahajan) fMahajan.value = "ALL";
    if (fRack) fRack.value = "ALL";
    if (typeof renderStock === "function") renderStock();
  };

  window.startAuditCameraScanner = function() {
    if (typeof window.startScanner === "function") {
      window.startScanner("AUDIT_CUSTOM", true);
    }
  };

  function installSafeComboCartCommit() {
    if (typeof window.commitComboToBillCart !== "function" || window.commitComboToBillCart._safeWrapped) return;
    const origCommit = window.commitComboToBillCart;
    const safeCommit = function() {
      origCommit();
      try {
        if (typeof cart === "undefined" || !Array.isArray(cart)) return;
        const liveInv = (typeof inventory !== "undefined" && Array.isArray(inventory)) ? inventory : [];
        const seenStockIndices = {};
        for (let i = 0; i < cart.length; i++) {
          const c = cart[i];
          if (!c || c.isComboDiscount) continue;
          const st = liveInv.find(x => x && x.code === c.code);
          if (st) {
            if (seenStockIndices[c.code] !== undefined) {
              const firstIdx = seenStockIndices[c.code];
              const combined = (Number(cart[firstIdx].qty) || 1) + (Number(c.qty) || 1);
              cart[firstIdx].qty = Math.min(Number(st.qty) || 1, combined);
              cart.splice(i, 1);
              i--;
            } else {
              c.qty = Math.min(Number(st.qty) || 1, Number(c.qty) || 1);
              seenStockIndices[c.code] = i;
            }
          }
        }
        if (typeof renderCart === "function") renderCart();
      } catch (e) {}
    };
    safeCommit._safeWrapped = true;
    window.commitComboToBillCart = safeCommit;
  }

  window.downloadBackupJSON = async function() {
    await reattachIdbPhotosToMandiBills();
    const backup = {
      app: "ShakyaCosmeticPOS",
      version: 4,
      exportedAt: new Date().toISOString(),
      inventory: typeof inventory !== "undefined" ? inventory : [],
      sales: typeof sales !== "undefined" ? sales : [],
      udhaarLogs: typeof udhaarLogs !== "undefined" ? udhaarLogs : [],
      expenses: typeof expenses !== "undefined" ? expenses : [],
      contacts: typeof contacts !== "undefined" ? contacts : [],
      mandiBills: Array.isArray(window.mandiBills) ? window.mandiBills : [],
      mandiPayments: Array.isArray(window.mandiPayments) ? window.mandiPayments : [],
      ownerPin: typeof ownerPin !== "undefined" ? ownerPin : "1234",
      merchantUpiId: typeof merchantUpiId !== "undefined" ? merchantUpiId : ""
    };
    const blob = new Blob([JSON.stringify(backup, null, 2)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "Shakya_POS_Backup_" + window.getLocalIsoDate() + ".json";
    a.click();
  };

  window.restoreBackupJSON = function(event) {
    const file = event && event.target && event.target.files ? event.target.files[0] : null;
    if (!file) return;
    const reader = new FileReader();
    reader.onload = async function(e) {
      try {
        const data = JSON.parse(e.target.result);
        if (!data || (!Array.isArray(data.inventory) && !Array.isArray(data.sales))) {
          if (typeof showInlineMsg === "function") showInlineMsg("backupMsg", "❌ Invalid backup file!", "error");
          return;
        }
        if (Array.isArray(data.inventory) && typeof inventory !== "undefined") {
          inventory.length = 0;
          data.inventory.filter(Boolean).forEach(x => inventory.push(x));
        }
        if (Array.isArray(data.sales) && typeof sales !== "undefined") {
          sales.length = 0;
          data.sales.filter(Boolean).forEach(x => sales.push(x));
        }
        if (Array.isArray(data.udhaarLogs) && typeof udhaarLogs !== "undefined") {
          udhaarLogs.length = 0;
          data.udhaarLogs.filter(Boolean).forEach(x => udhaarLogs.push(x));
        }
        if (Array.isArray(data.expenses) && typeof expenses !== "undefined") {
          expenses.length = 0;
          data.expenses.filter(Boolean).forEach(x => expenses.push(x));
        }
        if (Array.isArray(data.contacts) && typeof contacts !== "undefined") {
          contacts.length = 0;
          data.contacts.filter(Boolean).forEach(x => contacts.push(x));
        }
        if (Array.isArray(data.mandiBills)) {
          window.mandiBills = data.mandiBills.filter(Boolean);
          for (const b of window.mandiBills) {
            if (b && b.parchiPhoto && String(b.parchiPhoto).startsWith("data:image")) {
              await idbPut(STORE_PHOTOS, b.id || "MB", b.parchiPhoto);
            }
          }
          localStorage.setItem("sc_mandi_bills", JSON.stringify(window.mandiBills));
        }
        if (Array.isArray(data.mandiPayments)) {
          window.mandiPayments = data.mandiPayments.filter(Boolean);
          localStorage.setItem("sc_mandi_payments", JSON.stringify(window.mandiPayments));
        }
        if (typeof syncToCloud === "function") syncToCloud();
        if (typeof renderStock === "function") renderStock();
        if (typeof renderStats === "function") renderStats();
        if (typeof renderCustomerSection === "function") renderCustomerSection();
        refreshQuotaDashboardUI();
        if (typeof showInlineMsg === "function") {
          showInlineMsg("backupMsg", "✅ Full Backup (Stock + Bills + Udhaar + Mandi Khata) restore ho gaya!", "success");
        }
      } catch (err) {
        if (typeof showInlineMsg === "function") showInlineMsg("backupMsg", "❌ File padhne me error aaya.", "error");
      }
    };
    reader.readAsText(file);
  };

  const EXTRA_MODALS = [
    { id: "shComboModal", close: () => { const el = document.getElementById("shComboModal"); if (el) el.style.display = "none"; } },
    { id: "shAuditModal", close: () => { const el = document.getElementById("shAuditModal"); if (el) el.style.display = "none"; } },
    { id: "shPosterModal", close: () => { const el = document.getElementById("shPosterModal"); if (el) el.style.display = "none"; } },
    { id: "shVaadaModal", close: () => { const el = document.getElementById("shVaadaModal"); if (el) el.style.display = "none"; } },
    { id: "shPasandModal", close: () => { const el = document.getElementById("shPasandModal"); if (el) el.style.display = "none"; } },
    { id: "mandiInvoiceModal", close: () => { const el = document.getElementById("mandiInvoiceModal"); if (el) el.style.display = "none"; } },
    { id: "mandiPayModal", close: () => { const el = document.getElementById("mandiPayModal"); if (el) el.style.display = "none"; } }
  ];

  window.addEventListener("popstate", () => {
    const ribbon = document.getElementById("shakyaExcelRibbon");
    if (ribbon && ribbon.classList.contains("open")) {
      if (typeof window.closeExcelRibbon === "function") window.closeExcelRibbon();
      try { history.pushState({ posApp: true }, ""); } catch (e) {}
      return;
    }
    for (const m of EXTRA_MODALS) {
      const el = document.getElementById(m.id);
      if (el && (el.style.display === "flex" || el.style.display === "block")) {
        m.close();
        try { history.pushState({ posApp: true }, ""); } catch (e) {}
        return;
      }
    }
  });

  document.addEventListener("touchstart", () => {
    for (const m of EXTRA_MODALS) {
      const el = document.getElementById(m.id);
      if (el && (el.style.display === "flex" || el.style.display === "block")) {
        if (typeof ignoreSwipe !== "undefined") ignoreSwipe = true;
        return;
      }
    }
    const cs = document.getElementById("customSelectModal");
    const rb = document.getElementById("shakyaExcelRibbon");
    if ((cs && cs.style.display === "flex") || (rb && rb.classList.contains("open"))) {
      if (typeof ignoreSwipe !== "undefined") ignoreSwipe = true;
    }
  }, { capture: true, passive: true });

  function bootStorageQuotaEngine() {
    fixDateInputsToLocal();
    installSafeComboCartCommit();
    hydrateFromIndexedDBVault();
    if (typeof dbRef !== "undefined" && dbRef) {
      dbRef.child("mandiBills").on("value", () => {
        setTimeout(reattachIdbPhotosToMandiBills, 150);
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => setTimeout(bootStorageQuotaEngine, 180));
  } else {
    setTimeout(bootStorageQuotaEngine, 180);
  }
})();
