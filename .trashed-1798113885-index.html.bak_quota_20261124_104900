        if (ok) {
          showInlineMsg('billMsg', `🖨️ ${printerPrefs.mode} Printer se bill chhap gaya!`, 'success');
          return;
        }
      } catch (err) {
        showInlineMsg('billMsg', '⚠️ Direct Hardware Printer busy, fallback print chalu...', 'error');
      }
