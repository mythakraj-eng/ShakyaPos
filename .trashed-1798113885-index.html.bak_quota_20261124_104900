  window.adjustAuditCount = function(code, delta) {
    const item = getLiveInventory().find(i => i && i.code === code);
    if (!item) return;

    const cur = auditCountsMap[code] || 0;
    const next = Math.max(0, cur + delta);
    auditCountsMap[code] = next;

    const targetRack = document.getElementById("auRackFilterSel")?.value || "ALL";
    const itemRack = cleanRackStr(item.rack);

    if (delta > 0) {
      if (typeof playPosBeep === "function") playPosBeep(1040, 0.06);
      if (targetRack !== "ALL" && targetRack !== "UNSET" && itemRack && itemRack !== targetRack) {
        showAuditBanner(`⚠️ <b>गलत रैक अलर्ट!</b> <b>${item.code}</b> (${item.color}) की असली जगह <b>🗄️ Rack ${itemRack}</b> है! इसे वापस <b>${itemRack}</b> में रखें।`, true);
      } else {
        showAuditBanner(`✅ <b>${item.code}</b> (${item.cat} - ${item.color}) • गिना गया: <b>${next} / ${item.qty}</b> ${itemRack ? '• 🗄️ <b>Rack: ' + itemRack + '</b>' : ''}`, false);
      }
    }

    renderAuditList();
  };

