  // 3. Hook Stock Save, Edit, Filter & Table Render for Rack Support
  function hookStockForRack() {
    if (typeof window.saveStockItem === "function" && !window.saveStockItem._rackWrapped) {
      const origSaveStock = window.saveStockItem;
      const wrappedSaveStock = function() {
        const baseCode = cleanCode(document.getElementById("sCode")?.value || "");
        const colorRaw = (document.getElementById("sColor")?.value || "").trim();
        const rackVal = cleanRackStr(document.getElementById("sRackInput")?.value || "");

        origSaveStock();

        if (baseCode && rackVal) {
          const colors = colorRaw ? colorRaw.split(",").map(c => c.trim()).filter(Boolean) : ["Standard"];
          colors.forEach(color => {
            let finalCode = baseCode;
            if (colorRaw) {
              const upperCol = color.toUpperCase();
              const suffix = (typeof colorCodeMap === "object" && colorCodeMap[upperCol]) || cleanCode(upperCol).slice(0, 2);
              if (!baseCode.endsWith(suffix)) finalCode = `${baseCode}${suffix}`;
            }
            const item = getLiveInventory().find(i => i && i.code === finalCode);
            if (item) item.rack = rackVal;
          });
          if (typeof syncToCloud === "function") syncToCloud();
          if (typeof renderStock === "function") renderStock();
        }
      };
      wrappedSaveStock._rackWrapped = true;
      window.saveStockItem = wrappedSaveStock;
    }

    if (typeof window.openEditStockModal === "function" && !window.openEditStockModal._rackWrapped) {
      const origOpenEdit = window.openEditStockModal;
      const wrappedOpenEdit = function(code) {
        origOpenEdit(code);
        injectRackFieldsDOM();
        const item = getLiveInventory().find(i => i && i.code === code);
        const rEl = document.getElementById("editRackInput");
        if (rEl && item) rEl.value = item.rack || "";
      };
      wrappedOpenEdit._rackWrapped = true;
      window.openEditStockModal = wrappedOpenEdit;
    }

    if (typeof window.saveEditedStock === "function" && !window.saveEditedStock._rackWrapped) {
      const origSaveEdit = window.saveEditedStock;
      const wrappedSaveEdit = function() {
        const newCode = cleanCode(document.getElementById("editCode")?.value || "");
        const rackVal = cleanRackStr(document.getElementById("editRackInput")?.value || "");
        origSaveEdit();
        const item = getLiveInventory().find(i => i && i.code === newCode);
        if (item) {
          item.rack = rackVal;
          if (typeof syncToCloud === "function") syncToCloud();
          if (typeof renderStock === "function") renderStock();
        }
      };
      wrappedSaveEdit._rackWrapped = true;
      window.saveEditedStock = wrappedSaveEdit;
    }

    // Hook Mandi Studio commitStudioAll so items added in Mandi Studio also save their Rack No.
    if (typeof window.commitStudioAll === "function" && !window.commitStudioAll._rackWrapped) {
      const origCommitStudio = window.commitStudioAll;
      const wrappedCommitStudio = function(allowEmpty) {
        const studioRack = cleanRackStr(document.getElementById("msRackInp")?.value || "");
        const beforeCodes = new Set(getLiveInventory().map(i => i?.code));
        origCommitStudio(allowEmpty);
        if (studioRack) {
          getLiveInventory().forEach(i => {
            if (i && (!beforeCodes.has(i.code) || !i.rack)) {
              i.rack = studioRack;
            }
          });
          if (typeof syncToCloud === "function") syncToCloud();
          if (typeof renderStock === "function") renderStock();
        }
      };
      wrappedCommitStudio._rackWrapped = true;
      window.commitStudioAll = wrappedCommitStudio;
    }

    if (typeof window.getFilteredInventory === "function" && !window.getFilteredInventory._rackWrapped) {
      const origGetFiltered = window.getFilteredInventory;
      const wrappedGetFiltered = function() {
        let list = origGetFiltered();
        const fRackVal = document.getElementById("fRack")?.value || "ALL";
        const q = (document.getElementById("fSearch")?.value || "").trim().toUpperCase();

        // Also allow searching by Rack No. (e.g. "R-1") in main search box!
        if (q && list.length === 0) {
          list = getLiveInventory().filter(i => i && i.rack && i.rack.toUpperCase().includes(q));
        }

        if (fRackVal === "ALL") return list;
        if (fRackVal === "UNSET") return list.filter(i => !i.rack);
        return list.filter(i => i && cleanRackStr(i.rack) === fRackVal);
      };
      wrappedGetFiltered._rackWrapped = true;
      window.getFilteredInventory = wrappedGetFiltered;
    }

    if (typeof window.renderStock === "function" && !window.renderStock._rackWrapped) {
      const origRenderStock = window.renderStock;
      const wrappedRenderStock = function() {
        injectRackFieldsDOM();
        origRenderStock();
        const filtered = window.getFilteredInventory();
        const rows = document.querySelectorAll("#stockTableBody tr");
        rows.forEach((tr, idx) => {
          const item = filtered[idx];
          if (!item) return;
          const secondTd = tr.children[1];
          if (secondTd && !secondTd.querySelector(".sh-rack-badge")) {
            const badge = document.createElement("span");
            if (item.rack) {
              badge.className = "sh-rack-badge";
              badge.innerHTML = `🗄️ Rack: ${item.rack}`;
            } else {
              badge.className = "sh-rack-badge unset";
              badge.innerHTML = `🗄️ +Rack`;
            }
            badge.title = "Tap to set/change Rack No.";
            badge.onclick = (e) => {
              e.stopPropagation();
              quickPromptItemRack(item.code);
            };
            secondTd.appendChild(badge);
          }
        });
      };
      wrappedRenderStock._rackWrapped = true;
      window.renderStock = wrappedRenderStock;
    }
  }

