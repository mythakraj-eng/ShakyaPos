      `━━━━━━━━━━━━━━━━━━`,
      diffs.length > 0 ? `*अंतर / गायब आइटम (${diffs.length}):*\n` + diffs.join("\n") : `✅ सभी आइटम 100% बराबर मिले!`
    ];
    window.open("https://wa.me/?text=" + encodeURIComponent(lines.join("\n")), "_blank");
  };

  window.addEventListener("DOMContentLoaded", () => {
