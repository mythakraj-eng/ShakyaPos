  // Intercept scanner decode when isAuditScanActive is true
  function hookScannerForAudit() {
    const origStop = window.stopScanner;
    if (typeof origStop === "function" && !origStop._auditWrapped) {
      const wrappedStop = function() {
        origStop();
        setTimeout(() => {
          const scanVal = cleanCode(document.getElementById("scanInput")?.value || "");
          if (isAuditScanActive && scanVal) {
            isAuditScanActive = false;
            document.getElementById("scanInput").value = "";
            document.getElementById("auScanCodeInp").value = scanVal;
            auditCountByCodeInput();
          }
        }, 60);
      };
      wrappedStop._auditWrapped = true;
      window.stopScanner = wrappedStop;
    }

    if (typeof window.startScanner === "function" && !window.startScanner._auditModeWrapped) {
      const origStart = window.startScanner;
      const wrappedStart = function(mode) {
        if (mode === "AUDIT_CUSTOM") {
          isAuditScanActive = true;
          origStart("BILL");
        } else {
          isAuditScanActive = false;
          origStart(mode);
        }
      };
      wrappedStart._auditModeWrapped = true;
      window.startScanner = wrappedStart;
    }
  }

  function getScopedAuditItems() {
    const rackSel = document.getElementById("auRackFilterSel")?.value || "ALL";
    const q = cleanCode(document.getElementById("auScanCodeInp")?.value || "");
    return getLiveInventory().filter(i => {
      if (!i) return false;
      if (rackSel === "UNSET" && i.rack) return false;
      if (rackSel !== "ALL" && rackSel !== "UNSET" && cleanRackStr(i.rack) !== rackSel) return false;
      if (q && !cleanCode(i.code).includes(q) && !cleanCode(i.color || "").includes(q)) return false;
      return true;
    });
  }

  window.renderAuditList = function() {
    const listContainer = document.getElementById("auItemsListContainer");
    if (!listContainer) return;

    const scoped = getScopedAuditItems();
    let sysTotal = 0, phyTotal = 0, missingTotal = 0, extraTotal = 0;
    let diffItemsCount = 0, matchItemsCount = 0;

    scoped.forEach(i => {
      const sys = Math.max(0, Number(i.qty) || 0);
      const phy = auditCountsMap[i.code] || 0;
      sysTotal += sys;
      phyTotal += phy;
      if (phy < sys) {
        missingTotal += (sys - phy);
        diffItemsCount++;
      } else if (phy > sys) {
        extraTotal += (phy - sys);
        diffItemsCount++;
      } else {
        matchItemsCount++;
      }
    });

    document.getElementById("auKpiSys").textContent = sysTotal + " Pcs";
    document.getElementById("auKpiPhy").textContent = phyTotal + " Pcs";
    document.getElementById("auKpiMissing").textContent = missingTotal + " Pcs";
    document.getElementById("auKpiExtra").textContent = "+" + extraTotal + " Pcs";

    document.getElementById("auCntAll").textContent = scoped.length;
    document.getElementById("auCntDiff").textContent = diffItemsCount;
    document.getElementById("auCntMatch").textContent = matchItemsCount;

    const filtered = scoped.filter(i => {
      const sys = Math.max(0, Number(i.qty) || 0);
      const phy = auditCountsMap[i.code] || 0;
      if (auditViewTab === "DIFF") return phy !== sys;
      if (auditViewTab === "MATCH") return phy === sys;
      return true;
    });

    if (filtered.length === 0) {
      listContainer.innerHTML = `<div style="text-align:center; padding:20px; color:#64748b; font-size:12px;">Is filter mein koi stock item nahi hai.</div>`;
      return;
    }

    listContainer.innerHTML = filtered.map(i => {
      const sys = Math.max(0, Number(i.qty) || 0);
      const phy = auditCountsMap[i.code] || 0;
      const diff = phy - sys;
      let statusCls = "shortage";
      let diffBadge = `<span style="color:#dc2626; font-weight:900;">${diff} कम (Gayab)</span>`;
      if (diff === 0) {
        statusCls = "matched";
        diffBadge = `<span style="color:#059669; font-weight:900;">✅ बराबर</span>`;
      } else if (diff > 0) {
        statusCls = "excess";
        diffBadge = `<span style="color:#d97706; font-weight:900;">+${diff} ज्यादा</span>`;
      }

      return `
        <div class="sh-au-row ${statusCls}">
          <div style="flex:1;">
