  function exportSalesCSV() {
    if (sales.length === 0) {
      showInlineMsg('backupMsg', '⚠️ Abhi koi sale record nahi hai!', 'error');
      return;
    }
    let csv = 'Invoice,Date,Customer,Village,Mobile,PaymentMode,StickerMRP,ActualSale_ACC,ExchangeCredit,Paid,Due_Udhaar,Cost,NetProfit,Status,Items\n';
    sales.forEach(s => {
      const itemsStr = s.items.map(i => `${String(i.code||'').replace(/[=+@\\-]/g,'')}(${i.qty}pcs,Rs.${i.realSale}${i.returned ? ',RETURNED' : ''})`).join(' | ');
      const paidVal = s.paid !== undefined ? s.paid : s.acc;
      csv += `${s.invId},${s.date},"${s.cust}","${s.village || ''}",${s.mobile || ''},${s.mode},${s.totalMrp},${s.acc},${s.exchangeCredit || 0},${paidVal},${s.due || 0},${s.totalCost},${s.profit},${s.exchanged ? 'EXCHANGED' : 'SOLD'},"${itemsStr}"\n`;
    });
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `Shakya_Sales_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
    showInlineMsg('backupMsg', '✅ Sales Excel (.CSV) download ho gayi!', 'success');
  }

  function downloadBackupJSON() {
    const data = JSON.stringify({ version: 3, inventory, sales, udhaarLogs, expenses, contacts, ownerPin, merchantUpiId, printerPrefs, currentThemeKey });
    const blob = new Blob([data], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `Shakya_POS_Backup_${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    showInlineMsg('backupMsg', '✅ Full Backup (.JSON) download ho gaya!', 'success');
  }

  function restoreBackupJSON(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const parsed = JSON.parse(e.target.result);
        if (parsed.inventory && parsed.sales) {
          inventory = normalizeArray(parsed.inventory);
          sales = normalizeArray(parsed.sales);
          if (parsed.udhaarLogs) udhaarLogs = normalizeArray(parsed.udhaarLogs);
          if (parsed.expenses) expenses = normalizeArray(parsed.expenses);
