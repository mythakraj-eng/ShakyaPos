    upgradeAllBarcodesToQr();
    installReliableQrAndQueueScanner();
    injectQueueScanButtonInBilling();
    injectComboButtonInBilling();
    ensureHolographicOverlayDOM();
    cleanAnyExistingReceiptDualQr();
  }, 250);
})();
</script>
