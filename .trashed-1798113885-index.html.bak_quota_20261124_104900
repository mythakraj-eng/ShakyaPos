            <button type="button" class="btn-action" style="background:var(--maroon);color:#fff;" onclick="openMandiPartyDetail('${p.key}')">🧾 Bills</button>
          </div>
        </td>
      </tr>
    `).join("");
  };

  window.addEventListener("DOMContentLoaded", () => {
    buildMandiKhataDOM();
