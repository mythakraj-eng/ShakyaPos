<script>
  // =====================================================================
  // [JS-00: MULTI-THEME COLOUR UI ENGINE START]
  // =====================================================================
  const UI_THEMES = {
    INDIGO: {
      label: 'Indigo',
      maroon: '#2e1065',
      maroonDark: '#1e1b4b',
