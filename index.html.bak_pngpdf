<!-- CHUDI SIZE & TASTE MEMORY MODAL -->
<div id="shPasandModal">
  <div class="dialog-box" style="max-width:350px; text-align:left;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
      <h3 style="color:#9d174d; margin:0;">⭕ Grahak Chudi Size & Pasand</h3>
      <button type="button" class="small dark" style="margin:0; padding:3px 8px;" onclick="closeShPasandModal()">✕</button>
    </div>
    <div id="shPasandCustLabel" style="font-size:11.5px; font-weight:800; color:#475569; margin-bottom:8px;">Customer Profile</div>

    <label style="margin-top:0;">1. Chudi / Bangle Size Chunein:</label>
    <div class="sh-size-grid" id="shChudiSizeGrid">
      <div class="sh-size-pill" data-sz="2-2" onclick="pickShChudiSize('2-2')">⭕ 2-2 <small style="font-weight:600;display:block;font-size:9px;">Small</small></div>
      <div class="sh-size-pill" data-sz="2-4" onclick="pickShChudiSize('2-4')">⭕ 2-4 <small style="font-weight:600;display:block;font-size:9px;">Medium</small></div>
      <div class="sh-size-pill" data-sz="2-6" onclick="pickShChudiSize('2-6')">⭕ 2-6 <small style="font-weight:600;display:block;font-size:9px;">Regular</small></div>
      <div class="sh-size-pill" data-sz="2-8" onclick="pickShChudiSize('2-8')">⭕ 2-8 <small style="font-weight:600;display:block;font-size:9px;">Large</small></div>
      <div class="sh-size-pill" data-sz="2-10" onclick="pickShChudiSize('2-10')">⭕ 2-10 <small style="font-weight:600;display:block;font-size:9px;">Extra Large</small></div>
      <div class="sh-size-pill" data-sz="Kids" onclick="pickShChudiSize('Kids')">👧 Kids <small style="font-weight:600;display:block;font-size:9px;">Bachchon ka</small></div>
    </div>

    <label>2. Pasand / Saree & Blouse Note (Optional):</label>
    <input type="text" id="shPasandNoteInput" placeholder="Ex: Dark colours, Fancy Saree, Blouse 38" style="margin-top:3px; font-size:12.5px;">

    <div id="shAutoHistoryBox" style="margin-top:8px; padding:7px 9px; background:#f8fafc; border-radius:8px; border:1px solid #e2e8f0; font-size:11px; color:#334155;"></div>

    <div class="row" style="margin-top:12px;">
      <div><button type="button" class="dark" style="margin:0;" onclick="pickShChudiSize(''); saveShPasandProfile();">🧹 Clear</button></div>
      <div style="flex:1.5;"><button type="button" class="gold" style="margin:0;" onclick="saveShPasandProfile()">💾 Save Pasand</button></div>
    </div>
  </div>
</div>

