<!-- === SHAKYA COSMETIC: UDHAAR VAADA TARIKH & VILLAGE VASOOLI === -->

<!-- VAADA TARIKH (PROMISE DATE) SETTER MODAL -->
<div id="shVaadaModal">
  <div class="dialog-box" style="max-width:350px; text-align:left;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
      <h3 style="color:var(--maroon); margin:0;">📅 उधार वादा तारीख (Promise Date)</h3>
      <button type="button" class="small dark" style="margin:0; padding:3px 8px;" onclick="closeShVaadaModal()">✕</button>
    </div>
    <div id="shVaadaCustInfo" style="font-size:12px; font-weight:800; color:#334155; margin-bottom:8px;"></div>

    <label style="margin-top:0;">1. 1-Tap Jaldi Tarikh Chunein:</label>
    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:6px; margin:6px 0 10px 0;">
      <button type="button" class="small" style="margin:0; padding:7px 4px; background:#f1f5f9; color:#0f172a; border:1px solid #cbd5e1;" onclick="setModalVaadaOffset(3)">+3 Din</button>
      <button type="button" class="small" style="margin:0; padding:7px 4px; background:#f1f5f9; color:#0f172a; border:1px solid #cbd5e1;" onclick="setModalVaadaOffset(7)">+7 Din</button>
      <button type="button" class="small" style="margin:0; padding:7px 4px; background:#f1f5f9; color:#0f172a; border:1px solid #cbd5e1;" onclick="setModalVaadaOffset(15)">+15 Din</button>
      <button type="button" class="small" style="margin:0; padding:7px 4px; background:#eef2ff; color:#312e81; border:1px solid #c7d2fe;" onclick="setModalVaadaFirstOfMonth()">1 Tarikh</button>
    </div>

    <label>2. Ya Calendar se Pakki Tarikh Chunein:</label>
    <input type="date" id="shModalVaadaDateInput" style="margin-top:4px; font-size:14px; font-weight:800;">

    <label>Note / Vaada Baat (Optional):</label>
    <input type="text" id="shModalVaadaNoteInput" placeholder="Ex: Pension / Mandi aane par denge" style="margin-top:4px; font-size:12.5px;">

    <div class="row" style="margin-top:12px;">
      <div><button type="button" class="gold" style="margin:0;" onclick="saveCustomerVaadaDate(false)">💾 Sirf Save</button></div>
      <div><button type="button" class="whatsapp" style="margin:0;" onclick="saveCustomerVaadaDate(true)">💬 Save + WA Msg</button></div>
    </div>
    <button type="button" class="dark" style="margin-top:7px; padding:6px; font-size:11.5px;" onclick="clearCustomerVaadaDate()">🧹 Vaada Tarikh Hatayein</button>
  </div>
</div>

<script src="src/features/khata/vaada-vasooli.js"></script>
<!-- === END UDHAAR VAADA TARIKH & VILLAGE VASOOLI === -->
<!-- === SHAKYA COSMETIC: RACK LOCATION, TAG PRINT & FAST STOCK AUDIT === -->

<!-- FAST PHYSICAL STOCK AUDIT & RACK VERIFICATION MODAL -->
<div id="shAuditModal">
  <div class="sh-audit-studio">
    <div class="sh-au-topbar">
      <div class="sh-au-title">📋 Fast Physical Stock & Rack Audit</div>
      <div style="display:flex; gap:6px;">
        <button type="button" class="small" style="margin:0; padding:5px 9px; background:#334155; color:#fff;" onclick="resetCurrentAuditCounts()">🔄 Reset Count</button>
        <button type="button" class="small dark" style="margin:0; padding:5px 10px; background:rgba(255,255,255,0.14); border:1px solid rgba(255,255,255,0.25);" onclick="closeShAuditModal()">✕ Close</button>
      </div>
    </div>

    <div class="sh-au-kpis">
      <div class="sh-au-kpi"><small>System Qty</small><b id="auKpiSys">0 Pcs</b></div>
      <div class="sh-au-kpi"><small>Gina Gaya</small><b id="auKpiPhy" style="color:#38bdf8;">0 Pcs</b></div>
      <div class="sh-au-kpi"><small>Kam / Gayab</small><b id="auKpiMissing" style="color:#f87171;">0 Pcs</b></div>
      <div class="sh-au-kpi"><small>Extra / Faltu</small><b id="auKpiExtra" style="color:#4ade80;">0 Pcs</b></div>
    </div>

    <div class="sh-au-controls">
      <div class="row" style="gap:6px;">
        <div style="flex:1.1;">
          <select id="auRackFilterSel" onchange="onAuditRackFilterChange()" style="margin:0; padding:7px; font-size:12px; font-weight:800; border:1.5px solid var(--maroon); background:#fff;">
            <option value="ALL">🗄️ Sabhi Racks (Full Shop)</option>
          </select>
        </div>
        <div style="flex:1.3;">
          <input type="text" id="auScanCodeInp" placeholder="Code scan/type + Enter..." oninput="this.value=cleanCode(this.value); renderAuditList();" onkeydown="if(event.key==='Enter') auditCountByCodeInput()" style="margin:0; padding:7px 9px; font-size:12.5px; font-weight:800;">
        </div>
        <div style="flex:0.75;">
          <button type="button" class="gold" style="margin:0; padding:7px 6px; font-size:11.5px;" onclick="startAuditCameraScanner()">📷 Scan</button>
        </div>
      </div>

      <div id="auLiveScanAlert" class="sh-au-alert-banner"></div>

      <div class="sh-au-filter-tabs">
        <button type="button" id="auTabAll" class="sh-au-ftab active" onclick="setAuditViewTab('ALL')">📋 Sabhi (<span id="auCntAll">0</span>)</button>
        <button type="button" id="auTabDiff" class="sh-au-ftab" onclick="setAuditViewTab('DIFF')">⚠️ Antar / Gayab (<span id="auCntDiff">0</span>)</button>
        <button type="button" id="auTabMatch" class="sh-au-ftab" onclick="setAuditViewTab('MATCH')">✅ Barabar (<span id="auCntMatch">0</span>)</button>
      </div>
    </div>

    <div class="sh-au-list" id="auItemsListContainer"></div>

    <div class="sh-au-footer">
      <button type="button" class="whatsapp" style="margin:0; flex:1; font-size:12px;" onclick="shareAuditReportWA()">
        📲 WA Audit Report
      </button>
      <button type="button" class="gold" style="margin:0; flex:1.35; font-size:12px;" onclick="applyAuditCountsToInventory()">
        💾 Asli Count Stock Mein Save Karein
      </button>
    </div>
  </div>
</div>

<datalist id="shakyaRackList">
  <option value="R-1">Rack 1 (Daily Saree)</option>
  <option value="R-2">Rack 2 (Daily Saree)</option>
  <option value="R-3">Rack 3 (Fancy Saree)</option>
  <option value="R-4">Rack 4 (Wedding/Silk)</option>
  <option value="C-1">Counter 1 (Cosmetic)</option>
  <option value="C-2">Counter 2 (Chudi/Bangles)</option>
  <option value="B-1">Box / Petti 1</option>
  <option value="G-1">Godown / Upar</option>
</datalist>

<script src="src/features/inventory/stock-adjustments.js"></script>
<!-- === END RACK LOCATION, TAG PRINT & FAST STOCK AUDIT === -->


<!-- === SHAKYA COSMETIC: FIXED QR SCANNER, QUEUE SCAN MODE & COMBO === -->

<!-- SHAADI / TYOHAAR COMBO & LAGAN TROUSSEAU BUILDER MODAL -->
<div id="shComboModal">
  <div class="sh-combo-dialog">
    <div class="sh-cb-header">
      <div class="sh-cb-title">🎁 शादी / लगन एवं त्योहार कॉम्बो पैक</div>
      <button type="button" class="small dark" style="margin:0; padding:4px 9px; background:rgba(255,255,255,0.18);" onclick="closeShComboModal()">✕ Band</button>
    </div>

    <div class="sh-cb-body">
      <div style="font-size:11px; font-weight:800; color:#78350f; margin-bottom:5px;">
        👇 1-Tap रेडीमेड दुकान कॉम्बो चुनें (या नीचे आइटम बदलें):
      </div>

      <div class="sh-cb-presets">
        <div class="sh-cb-preset-card active" id="cbPreset_READY_SAREE" onclick="loadComboPreset('READY_SAREE')">
          <div>
            <div class="sh-cb-preset-title">✨ साड़ी + पेटीकोट + फॉल-पिको सेट</div>
            <div class="sh-cb-preset-sub">1 साड़ी + मैचिंग पेटीकोट + ब्लाउज/फॉल-पिको रेडी पैक</div>
          </div>
          <span class="sh-cb-preset-badge">🔥 फॉल-पिको FREE ऑफर</span>
        </div>

        <div class="sh-cb-preset-card" id="cbPreset_LAGAN_SHAGUN" onclick="loadComboPreset('LAGAN_SHAGUN')">
          <div>
            <div class="sh-cb-preset-title">👰 लगन / विदाई शगुन सुहाग सेट</div>
            <div class="sh-cb-preset-sub">फैंसी साड़ी + पेटीकोट + फॉल-पिको + सुहाग चूड़ी + मेकअप शगुन</div>
          </div>
          <span class="sh-cb-preset-badge">💎 ₹130 शगुन छूट</span>
        </div>

        <div class="sh-cb-preset-card" id="cbPreset_LEN_DEN_5" onclick="loadComboPreset('LEN_DEN_5')">
          <div>
            <div class="sh-cb-preset-title">🎉 5 साड़ी लेन-देन (रिश्तेदारी) पैक</div>
            <div class="sh-cb-preset-sub">शादी में रिश्तेदारों को देने के लिए 5 साड़ियों का बंडल</div>
          </div>
          <span class="sh-cb-preset-badge">🎁 बंडल थोक छूट</span>
        </div>

        <div class="sh-cb-preset-card" id="cbPreset_BRIDAL_COS" onclick="loadComboPreset('BRIDAL_COS')">
          <div>
            <div class="sh-cb-preset-title">💄 दुल्हन सुहाग & कॉस्मेटिक किट</div>
            <div class="sh-cb-preset-sub">चूड़ी सेट + सिंदूर/बिंदी + लिपस्टिक + फेशियल/मेकअप किट</div>
          </div>
          <span class="sh-cb-preset-badge">✨ कॉस्मेटिक कॉम्बो</span>
        </div>
      </div>

      <div style="background:#ffffff; border:1.5px solid #cbd5e1; border-radius:9px; padding:7px 9px; margin-bottom:8px;">
        <div style="font-size:10.5px; font-weight:900; color:var(--maroon); margin-bottom:4px;">
          👗 स्टॉक में से असली साड़ी कॉम्बो में जोड़ें (Stock Qty भी अपने-आप घटेगी):
        </div>
        <div class="row" style="gap:6px;">
          <div style="flex:1.8;">
            <select id="cbStockSareeSel" style="margin:0; padding:5px 7px; font-size:11.5px; font-weight:800; height:32px;">
              <option value="">-- स्टॉक से साड़ी चुनें (Optional) --</option>
            </select>
          </div>
          <div style="flex:0.85;">
            <button type="button" class="gold" style="margin:0; padding:5px 8px; height:32px; font-size:11px;" onclick="insertSelectedStockIntoCombo()">+ कॉम्बो में डालें</button>
          </div>
        </div>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
        <span style="font-size:11px; font-weight:900; color:#1e293b;">📦 कॉम्बो में शामिल आइटम:</span>
        <button type="button" class="small" style="margin:0; padding:3px 8px; font-size:10.5px; background:#0f172a; color:#fde047;" onclick="addBlankComboRow()">+ एक और आइटम जोड़ें</button>
      </div>

      <div id="cbItemsContainer"></div>

      <div class="sh-cb-summary">
        <div style="display:flex; justify-content:space-between; align-items:center; font-size:12px;">
          <span>कुल अलग-अलग रेट (Total MRP):</span>
          <b id="cbTotalMrpTxt" style="font-size:14px; text-decoration:line-through; color:#cbd5e1;">₹0</b>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px; gap:10px;">
          <div>
            <div style="font-size:12.5px; font-weight:900; color:#fde047;">🎯 स्पेशल कॉम्बो पैकेज रेट (₹):</div>
            <div id="cbSavingsBadge" style="font-size:10.5px; color:#a7f3d0; font-weight:800; margin-top:1px;">ग्राहक की बचत: ₹0</div>
          </div>
          <input type="number" id="cbPackagePriceInp" oninput="onComboPackagePriceEdit()" style="width:115px; margin:0; padding:6px 8px; font-size:16px; font-weight:900; color:#0f172a; background:#fde047; border:2px solid #ffffff; border-radius:8px; text-align:right;">
        </div>
      </div>
    </div>

    <div class="sh-cb-footer">
      <button type="button" class="dark" style="margin:0; flex:0.75; font-size:12px;" onclick="closeShComboModal()">Cancel</button>
      <button type="button" class="gold" style="margin:0; flex:1.55; font-size:12.5px; background:linear-gradient(135deg,#059669,#047857); color:#fff;" onclick="commitComboToBillCart()">
        🛒 पूरा कॉम्बो बिल में जोड़ें
      </button>
    </div>
  </div>
</div>

<!-- Hidden File Input for Camera/Photo QR Scan Fallback -->
<input type="file" id="shQrImageFallbackInp" accept="image/*" capture="environment" style="display:none;" onchange="handleFallbackQrPhoto(this)">
<div id="shQrTempFileReader" style="display:none;"></div>

<script src="src/features/scanner/scanner.js"></script>
<script src="src/features/billing/billing.js"></script>
<!-- === END FIXED QR SCANNER, QUEUE SCAN MODE & COMBO === -->
<!-- [SHAKYA-IMMORTAL-LOCAL-SW-V1 START] -->
<script src="src/app/local-sw-keepalive.js"></script>
<!-- [SHAKYA-IMMORTAL-LOCAL-SW-V1 END] -->

<!-- [PHASE-M7: PRODUCTION RESILIENCE SERVICES START] -->
<script src="src/services/storage/atomic-wal.js"></script>
<script src="src/features/scanner/hardware-gun-battery.js"></script>
<script src="src/services/sync/conflict-resolution.js"></script>
<script src="src/services/sync/sync-manager.js"></script>
<script src="src/services/storage/local-storage.js"></script>
<!-- [PHASE-M7: PRODUCTION RESILIENCE SERVICES END] -->
</body>
</html>
