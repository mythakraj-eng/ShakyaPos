<!-- WHATSAPP STATUS POSTER STUDIO MODAL -->
<div id="shPosterModal">
  <div class="sh-poster-studio">
    <div class="sh-ps-topbar">
      <div class="sh-ps-title">🌟 WhatsApp Status Saree Poster Studio</div>
      <button type="button" class="small dark" style="margin:0; padding:5px 10px; background:rgba(255,255,255,0.14); border:1px solid rgba(255,255,255,0.25);" onclick="closeShPosterModal()">✕ Close</button>
    </div>

    <div class="sh-ps-body">
      <!-- STEP 1: PICK 1 TO 4 ITEMS FROM STOCK -->
      <div class="sh-ps-ctrl-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
          <span class="sh-ps-lbl" style="margin:0;">1. Stock se 1 se 4 Items Chunein (Tap to Select):</span>
          <input type="text" id="shPsSearchInp" placeholder="🔍 Code/Colour..." oninput="renderPosterStockChips()" style="width:120px; margin:0; padding:3px 7px; font-size:11px; height:26px;">
        </div>
        <div class="sh-ps-stock-chips" id="shPsStockChips"></div>
      </div>

      <!-- STEP 2: THEME & HEADLINE -->
      <div class="sh-ps-ctrl-card">
        <span class="sh-ps-lbl">2. Poster Colour Theme & Headline Chunein:</span>
        <div class="sh-ps-pill-row" id="shPsThemeRow" style="margin-bottom:7px;">
          <div class="sh-ps-pill active" onclick="setShPosterTheme('theme-maroon', this)">👑 Royal Maroon</div>
          <div class="sh-ps-pill" onclick="setShPosterTheme('theme-indigo', this)">🌌 Boutique Indigo</div>
          <div class="sh-ps-pill" onclick="setShPosterTheme('theme-rani', this)">🌺 Festive Rani Pink</div>
        </div>

        <div class="sh-ps-pill-row" id="shPsHeadlineRow" style="margin-bottom:7px;">
          <div class="sh-ps-pill active" onclick="setShPosterHeadline('✨ आज का नया साड़ी कलेक्शन ✨', this)">✨ नया कलेक्शन</div>
          <div class="sh-ps-pill" onclick="setShPosterHeadline('👰 शादी-लगन स्पेशल धमाका 👰', this)">👰 शादी-लगन स्पेशल</div>
          <div class="sh-ps-pill" onclick="setShPosterHeadline('🎉 त्यौहार महा-ऑफर सेल 🎉', this)">🎉 त्यौहार ऑफर</div>
          <div class="sh-ps-pill" onclick="setShPosterHeadline('💄 नया कॉस्मेटिक एवं चूड़ी स्टॉक 💄', this)">💄 कॉस्मेटिक स्पेशल</div>
        </div>

        <div class="row">
          <div style="flex:1.2;">
            <input type="text" id="shPsCustomHeadline" placeholder="Headline badlein..." value="✨ आज का नया साड़ी कलेक्शन ✨" oninput="renderLivePosterCard()" style="margin:0; padding:6px 8px; font-size:11.5px;">
          </div>
          <div style="flex:1;">
            <input type="text" id="shPsCustomSubline" placeholder="Offer line..." value="सीमित स्टॉक • आज ही पधारें!" oninput="renderLivePosterCard()" style="margin:0; padding:6px 8px; font-size:11.5px;">
          </div>
        </div>
      </div>

      <!-- LIVE VERTICAL POSTER PREVIEW -->
      <div style="font-size:10.5px; font-weight:800; color:#475569; text-align:center; margin-bottom:3px;">
        👇 किसी भी साड़ी कार्ड पर टैप करके उसकी असली फोटो (📷 Camera/Gallery) भी लगा सकते हैं:
      </div>
      <input type="file" id="shPsItemPhotoInput" accept="image/*" style="display:none;" onchange="onPosterItemPhotoPicked(event)">

      <div class="sh-poster-preview-wrap">
        <div id="shPosterCanvasCard" class="theme-maroon">
          <div class="sh-p-inner-frame">
            <div>
              <div class="sh-p-top-crest">
                <div class="sh-p-didi-pill">✨ दीदी की दुकान ✨</div>
                <h2 class="sh-p-shop-name">SHAKYA COSMETIC</h2>
                <div class="sh-p-shop-sub">शाक्या कॉस्मेटिक एवं साड़ी कलेक्शन</div>
              </div>

              <div class="sh-p-headline-box">
                <div class="sh-p-headline-txt" id="shPosterLiveHeadline">✨ आज का नया साड़ी कलेक्शन ✨</div>
                <div class="sh-p-suboffer-txt" id="shPosterLiveSubline">सीमित स्टॉक • आज ही पधारें!</div>
              </div>
            </div>

            <div id="shPosterItemsGrid" class="sh-p-grid count-2"></div>

            <div class="sh-p-footer">
              📍 राम दरा रोड, निवाड़ी कलां (इटावा)<br>
              📞 WhatsApp / Call: <b>8780234760</b>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="sh-ps-bottom-bar">
      <button type="button" class="gold" style="margin:0; flex:1; font-size:12.5px;" onclick="exportPosterImage('DOWNLOAD')">
        ⬇️ Save HD Poster
      </button>
      <button type="button" class="whatsapp" style="margin:0; flex:1.3; font-size:12.5px;" onclick="exportPosterImage('SHARE')">
        📲 Share to WhatsApp Status
      </button>
    </div>
  </div>
</div>

<script src="src/features/printing/wa-poster.js"></script>
